    "findings": [
      {
        "file": "django/forms/boundfield.py",
        "start_line": 195,
        "end_line": 197,
        "side": "new",
        "severity": "medium",
        "category": "bug",
        "title": "legend_tag mutates caller's attrs dict when required_css_class applies",
        "explanation": "The old code always built a new dict via {**attrs, 'for': ...}. Now for tag == 'legend' the caller's dict is used directly. The later `attrs['class'] += ' ' + required_css_class` or `attrs['class'] = ...` then mutates the caller's dict. Reusing one attrs dict across calls appends the required class repeatedly, or leaks it into other calls.",
        "suggestion": "Copy always: `attrs = {**(attrs or {})}` or `attrs = dict(attrs or {})`, then add 'for' if tag != 'legend'.",
        "evidence": "attrs = attrs or {}",
        "confidence": 0.7,
        "id": "85598e822c6d",
