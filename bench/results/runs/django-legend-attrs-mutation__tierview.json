    "findings": [
      {
        "file": "django/forms/boundfield.py",
        "start_line": 195,
        "end_line": 201,
        "side": "new",
        "severity": "medium",
        "category": "bug",
        "title": "legend_tag now mutates the caller's attrs dict when adding required class",
        "explanation": "The old code always made a new dict (`{**(attrs or {}), \"for\": ...}`) whenever id_for_label was truthy, so the caller's dict was never changed. With this change the copy only happens when tag != \"legend\". For legend_tag, `attrs = attrs or {}` keeps the caller's own dict. If the field is required and the form defines required_css_class, line 201 (`attrs[\"class\"] += ...`) or line 203 then changes that dict in place. A caller who passes the same attrs dict to more than one legend_tag call, or keeps using it afterwards, gets the class appended again each time (e.g. \"x required required\"). The same thing can happen to a shared dict, such as a module-level constant.",
        "suggestion": "Always copy the dict: `attrs = {**(attrs or {})}` and then `if tag != \"legend\": attrs[\"for\"] = id_for_label`. Or, simpler: `attrs = {**(attrs or {}), \"for\": id_for_label}` followed by `if tag == \"legend\": attrs.pop(\"for\")`.",
        "evidence": "attrs = attrs or {}",
        "confidence": 0.72,
        "id": "96b59167303c",
        "hunk_id": "django/forms/boundfield.py#1",
        "model": "claude-opus-5-5",
        "tier": 2,
        "escalated_from": [
          1
        ],
        "also_reported_by": []
      },
      {
        "file": "django/forms/boundfield.py",
        "start_line": 195,
        "end_line": 197,
        "side": "new",
        "severity": "medium",
        "category": "bug",
        "title": "legend path no longer copies attrs; caller's dict mutated",
        "explanation": "Previously attrs was always copied via dict unpacking. For legend, attrs is now the caller's own dict. The later required_css_class branch does attrs['class'] += ..., which mutates the caller's dict. Reusing the same attrs dict across calls appends the class repeatedly.",
        "suggestion": "Copy it: attrs = dict(attrs or {}), or build the copy before the tag check.",
        "evidence": "attrs = attrs or {}",
        "confidence": 0.55,
