    "version": 1,
    "findings": [
      {
        "file": "nbd/server.c",
        "start_line": 2455,
        "end_line": 2456,
        "side": "new",
        "severity": "high",
        "category": "security",
        "title": "Client-triggerable assertion failure when payload sent without meta contexts",
        "explanation": "client->contexts.exp is only set by NBD_OPT_SET_META_CONTEXT, and nbd_check_meta_export only resets count (not exp) when the export changes. The receive path enters this function whenever the client sets NBD_CMD_FLAG_PAYLOAD_LEN in extended mode, regardless of whether NBD_FLAG_BLOCK_STAT_PAYLOAD was advertised. A client that negotiates extended headers but never sets meta contexts (contexts.exp == NULL), or sets them on export A and then does OPT_GO on export B, can send BLOCK_STATUS with the payload flag. The assert then aborts the server process (remote DoS).",
        "suggestion": "Before the assert, if client->contexts.count == 0 or client->contexts.exp != client->exp, allocate the empty request->contexts and take the skip path (drop the payload, reply EINVAL). Alternatively, make nbd_check_meta_export also reset contexts.exp.",
        "evidence": "    assert(client->contexts.exp == client->exp);",
        "confidence": 0.65,
        "id": "f9739e73b229",
        "hunk_id": "nbd/server.c#3",
        "model": "claude-opus-5-5",
        "tier": 3,
        "escalated_from": [],
        "also_reported_by": []
      }
