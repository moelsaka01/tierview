      {
        "file": "block/vmdk.c",
        "start_line": 876,
        "end_line": 877,
        "side": "new",
        "severity": "medium",
        "category": "bug",
        "title": "Grain marker fields written in host byte order",
        "explanation": "The on-disk marker is little-endian; the reader uses le32_to_cpu(marker->size). On big-endian hosts, lba and size are written in the wrong byte order, which produces invalid images and failed reads.",
        "suggestion": "data->lba = cpu_to_le64(sector_num); data->size = cpu_to_le32(buf_len);",
        "evidence": "        data->size = buf_len;",
