    "version": 1,
    "findings": [
      {
        "file": "drivers/net/mlx5/mlx5_flow_hw.c",
        "start_line": 5324,
        "end_line": 5324,
        "side": "new",
        "severity": "high",
        "category": "bug",
        "title": "Egress group shift dropped for E-Switch when xmeta is not META32_HWS",
        "explanation": "Representor matching is now always enabled, so the old condition (repr_matching || META32_HWS) was always true when dv_esw_en is set. Group 0 egress is reserved for the default Tx repr tagging rule. After this change the user group is only shifted in META32_HWS mode. With other xmeta modes, user egress tables on E-Switch setups land in group 0 and collide with the PMD-reserved tagging table.",
        "suggestion": "Drop the xmeta condition so that dv_esw_en && external && flow_attr->egress always shifts the group.",
        "evidence": "\t\t   config->dv_xmeta_en == MLX5_XMETA_MODE_META32_HWS &&",
        "confidence": 0.6,
        "id": "e060aad115a8",
        "hunk_id": "drivers/net/mlx5/mlx5_flow_hw.c#1",
        "model": "claude-sonnet-5-5",
        "tier": 3,
