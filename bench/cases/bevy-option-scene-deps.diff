+impl<P> Scene for Option<P>
+where
+    P: Scene,
+{
+    #[inline]
+    fn resolve(
+        self,
+        context: &mut ResolveContext,
+        scene: &mut ResolvedScene,
+    ) -> Result<(), ResolveSceneError> {
+        self.map(|optional_scene| optional_scene.resolve(context, scene))
+            .unwrap_or(Ok(()))
+    }
+}
