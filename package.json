{
  "name": "tierview",
  "version": "0.1.0",
  "description": "AI code review that escalates through Claude model tiers and prints a cost receipt.",
  "license": "MIT",
  "author": "Mohamed Elsaka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moelsaka01/tierview.git"
  },
  "type": "module",
  "bin": {
    "tierview": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "config",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "bench:build": "tsup bench/mine.ts bench/validate.ts bench/routing.ts bench/run.ts bench/metrics.ts bench/tune.ts bench/tune-grid.ts bench/chart.ts bench/audit.ts --format esm --target node22 --out-dir .bench-build --silent",
    "bench:mine": "npm run bench:build && node .bench-build/mine.js",
    "bench:validate": "npm run bench:build && node .bench-build/validate.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "code-review",
    "claude",
    "anthropic",
    "llm",
    "model-routing",
    "github-action",
    "cli"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "commander": "^15.1.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "ajv": "^8.20.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/moelsaka01/tierview#readme",
  "bugs": {
    "url": "https://github.com/moelsaka01/tierview/issues"
  }
}
